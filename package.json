{
	"name": "nextjs-blog",
	"description": "Personal blog — Next.js on Vercel (Bun); local dev: bun run dev (portless → https://robinandeer.localhost)",
	"version": "2.6.1",
	"private": true,
	"portless": {
		"name": "robinandeer",
		"script": "dev:app"
	},
	"scripts": {
		"dev": "portless",
		"dev:app": "next dev",
		"dev:webpack": "next dev --webpack",
		"build": "bun --bun next build",
		"start": "bun --bun next start",
		"analyze": "next experimental-analyze",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"check": "bun run lint && bun run build",
		"generate-art": "bun run scripts/generate-contribution-art.ts"
	},
	"dependencies": {
		"@runwayml/sdk": "^4.9.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.24.0",
		"next": "^16.3.0-preview.6",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"next-view-transitions": "^0.3.5",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-pretty-code": "^0.14.4",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.3.1",
		"tailwind-merge": "^3.6.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@tailwindcss/postcss": "^4.3.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"portless": "^0.15.1",
		"tailwindcss": "^4.3.2",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"yaml": "2.9.0"
	}
}
